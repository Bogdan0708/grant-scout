# Required at runtime: streams answers with tool use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Required at runtime: embeds each search query against the committed corpus vectors.
# Also used by `npm run embed` to rebuild data/vectors.json.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Public-demo safeguards. These counters are in-memory and reset on cold start.
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_MS=60000
DAILY_REQUEST_LIMIT=250
